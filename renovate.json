{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["develop", "/^\\d+(\\.\\d+)?\\.x$/"],
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "branchPrefix": "deps/",
  "labels": ["dependencies"],
  "enabledManagers": ["github-actions", "npm"],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to immutable commit SHAs (supply-chain hardening). Scoped to github-actions only — a global pinDigests caused Yarn Berry (npm) lockfile artifact-update failures: the deps/all PR (#759) regenerates yarn.lock with digest-pinned npm entries that `yarn install --immutable` then rejects (YN0028). npm packages already carry integrity hashes in yarn.lock, so digest pinning adds nothing but breakage there.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Freeze the build-stack boundary packages (Node, Yarn, Vue, Nuxt, and core build/lint/test tooling) — these are pinned intentionally and bumped only as part of a deliberate, coordinated upgrade, not routine automation.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "node",
        "yarn",
        "siroc",
        "vue",
        "vue-template-compiler",
        "nuxt",
        "jest",
        "eslint",
        "@commitlint/cli",
        "@commitlint/config-conventional",
        "@nuxtjs/storybook",
        "@tailwindcss/typography",
        "markdownlint-cli2",
        "renovate"
      ],
      "enabled": false
    },
    {
      "description": "Disable all major-version bumps — majors require manual review, not automated merging.",
      "matchManagers": ["npm", "github-actions"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "GitHub Actions in one PR.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Root tooling not covered by a narrower group below.",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["devDependencies", "resolutions"],
      "groupName": "dev tooling"
    },
    {
      "description": "Test tooling, kept together so the runner and its helpers move as one.",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "jest-*",
        "@jest/*",
        "babel-jest",
        "esbuild-jest",
        "vue-jest",
        "@vue/test-utils",
        "cypress",
        "start-server-and-test"
      ],
      "groupName": "test tooling"
    },
    {
      "description": "Lint and commit tooling.",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "eslint-*",
        "@commitlint/*",
        "cspell",
        "knip",
        "lint-staged",
        "husky",
        "prettier"
      ],
      "groupName": "lint tooling"
    },
    {
      "description": "Release tooling.",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["devDependencies", "resolutions"],
      "matchPackageNames": [
        "@changesets/*",
        "bundlewatch",
        "semver",
        "human-id"
      ],
      "groupName": "release tooling"
    },
    {
      "description": "The agent evaluation harness, which ships nowhere.",
      "matchFileNames": [".agents/**"],
      "groupName": "agent evals"
    },
    {
      "description": "Example sites, which ship nowhere.",
      "matchFileNames": ["examples/**"],
      "groupName": "examples"
    },
    {
      "description": "Packages get one PR per dependency, so its title names the package and version, and every package's use of it moves together.",
      "matchFileNames": [
        "packages/*/package.json",
        "!packages/test-utils/package.json"
      ],
      "matchDepTypes": [
        "dependencies",
        "peerDependencies",
        "optionalDependencies"
      ],
      "semanticCommitType": "fix",
      "addLabels": ["published"],
      "prBodyNotes": [
        "This dependency ships to every site that installs the package. Add a changeset saying what changes for a site, if anything."
      ]
    },
    {
      "description": "druxt-test-utils is private, so its dependencies are test tooling.",
      "matchFileNames": ["packages/test-utils/package.json"],
      "groupName": "test tooling"
    }
  ]
}
