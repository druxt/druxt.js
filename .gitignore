# Dependencies
node_modules

# Yarn 2
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*

# Only keep yarn.lock in the root
package-lock.json
*/**/yarn.lock

# Dist folders
# Scoped to packages/: a bare `bin` also matched examples/node-client/bin,
# which is hand-written source, not docgen's build output.
packages/*/bin
dist
packages/*/nuxt

# Build files
packages/*/package.tgz

# Coverage / test reports
coverage
reports

# Cypress failure artifacts (every example app's test/cypress/ generates
# these on a failed run - not source, never meant to be committed)
**/test/cypress/screenshots
**/test/cypress/videos

# Intellij idea
*.iml
.idea

# OSX
.DS_Store
.AppleDouble
.LSOverride

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
