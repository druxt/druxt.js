{
  "files": ["**/*.{js,vue,json,md,yml,yaml}"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell-project-words.txt"
    }
  ],
  "dictionaries": ["bash", "misc", "node", "project-words", "softwareTerms"],
  "ignorePaths": [
    "packages/blocks/",
    "packages/breadcrumb/",
    "packages/docgen/",
    "packages/druxt/",
    "packages/entity/",
    "packages/menu/",
    "packages/router/",
    "packages/schema/",
    "packages/site/",
    "packages/views/",
    "test/mixins.test.js",
    "**/CHANGELOG.md",
    "**/__fixtures__/**",
    "**/node_modules/",
    "**/test/fixtures/**",
    "*.gif",
    "*.ico",
    "*.jpg",
    "*.lock",
    "*.min.*",
    "*.png",
    "*.svg",
    ".git/",
    ".yarn/",
    "coverage/",
    "examples/*/node_modules/",
    "node_modules/",
    "package-lock.json",
    "packages/*/dist/",
    "packages/*/nuxt/",
    "packages/*/templates/",
    "yarn.lock",
    "**/.nuxt/**",
    "**/.output/**"
  ],
  "useGitignore": true,
  "ignoreWords": [
    "Aworking",
    "Benabled",
    "Bfile",
    "Blimit",
    "Bmedia",
    "Bmenu",
    "Bnode",
    "Boffset",
    "Bstatus",
    "Cfield",
    "aadf",
    "activedescendant",
    "downarrow",
    "druxtblock",
    "druxtblockregion",
    "druxtbreadcrumb",
    "druxtdebug",
    "druxtentity",
    "druxtentityform",
    "druxtmenu",
    "druxtmodule",
    "druxtrouter",
    "druxtsite",
    "druxtview",
    "fetc",
    "fpasswd",
    "hids",
    "leftarrow",
    "mediterr",
    "rightarrow"
  ]
}
