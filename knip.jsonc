{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    // 1.x packages not yet ported: each leaves this list in its port's merge request.
    "packages/blocks/**",
    "packages/breadcrumb/**",
    "packages/docgen/**",
    "packages/druxt/**",
    "packages/entity/**",
    "packages/menu/**",
    "packages/router/**",
    "packages/schema/**",
    "packages/site/**",
    "packages/test-utils/**",
    "packages/views/**",
    "test/drupal.js",
    "test/exports.test.js",
    "test/mixins.test.js",
    "test/setup.js",
    "test/standalone-files.test.js",
    "test/storyTemplates.test.js",
    "test/__mocks__/**",
    // 1.x examples, run on the 1.x line.
    "examples/**",
    "test/__fixtures__/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        // Not run by any CI job yet: the core port adds the job that runs it.
        "scripts/nuxt-floor.mjs"
      ],
      // pinia: the packages that use it declare it. The unit tests of their stores import it too.
      // vue-router: Nuxt's own, which a unit test builds a router with.
      "ignoreDependencies": ["pinia", "vue-router"]
    }
  },
  // Nuxt's virtual modules, and the build templates the Druxt modules alias as #druxt/*.
  "ignoreUnresolved": ["#app", "#imports", "#build/.*", "#druxt/.*"],
  // A helper a script exports and also calls itself, for its tests' sake.
  "ignoreExportsUsedInFile": true,
  // The workflows are 1.x's; 2.0.x runs on GitLab CI alone for now.
  "github-actions": false,
  // `npx promptfoo eval -c promptfooconfig.yaml`, read as two binaries.
  "ignoreBinaries": ["promptfooconfig.yaml"]
}
