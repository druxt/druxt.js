{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    // 1.x packages not yet ported: each leaves this list in its port's merge request.
    "packages/blocks/**",
    "packages/breadcrumb/**",
    "packages/docgen/**",
    "packages/entity/**",
    "packages/menu/**",
    "packages/router/**",
    "packages/schema/**",
    "packages/site/**",
    "packages/views/**",
    "test/mixins.test.js",
    // Compat's copy of the 1.x sources, kept as 1.x laid them out.
    "packages/compat/src/legacy/**",
    // 1.x examples, run on the 1.x line.
    "examples/**",
    "test/__fixtures__/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "test/standalone/fixtures/*/app/app.vue",
        "test/standalone/fixtures/*/app/pages/*.vue",
        // The component tests' Nuxt app.
        "test/nuxt/app/app.vue",
        "test/nuxt/setup.ts",
        // Run by the test:nuxt-floor CI job.
        "scripts/nuxt-floor.mjs",
        // Run by hand: node scripts/bench/process-cache.mjs.
        "scripts/bench/*.mjs"
      ],
      // pinia: the packages that use it declare it. The unit tests of their stores import it too.
      // vue-router: Nuxt's own, which a unit test builds a router with.
      // nuxt-auth-utils: a module the auth-utils standalone fixture lists by name, beside @druxt/core.
      "ignoreDependencies": ["pinia", "vue-router", "nuxt-auth-utils"]
    },
    "packages/*": {
      // A Nuxt module registers its runtime files by path, through
      // addPlugin(), addComponent() and the like, which no import names.
      "entry": ["src/runtime/**/*.{ts,vue}"]
    },
    "packages/core": {
      // build.config.ts: unbuild's, read by nuxt-module-build for the kit entry.
      "entry": ["src/module.ts", "src/runtime/**/*.{ts,vue}", "build.config.ts"],
      // @pinia/nuxt: installed by name, with installModule(). nitropack: Nuxt's own server runtime, imported for useNitroApp().
      // @nuxt/devtools-kit: an optional peer, imported by name through loadDruxtTools() in development only.
      "ignoreDependencies": ["@pinia/nuxt", "nitropack", "@nuxt/devtools-kit"]
    }
  },
  // Nuxt's virtual modules, and the build templates the Druxt modules alias as #druxt/*.
  "ignoreUnresolved": ["#app", "#imports", "#build/.*", "#druxt/.*"],
  // A helper a script exports and also calls itself, for its tests' sake.
  "ignoreExportsUsedInFile": true,
  // Off: every script the workflows run is reached from package.json or a test.
  "github-actions": false,
  // `npx promptfoo eval -c promptfooconfig.yaml`, read as two binaries.
  "ignoreBinaries": ["promptfooconfig.yaml"]
}
