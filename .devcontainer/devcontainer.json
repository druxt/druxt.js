{
  "name": "Druxt",
  // A prebuilt image with the tools, PHP and its extensions, and the
  // locales. It is defined in .github/.devcontainer and published by
  // .github/workflows/devcontainer.yml when that definition changes on a
  // release line, and weekly. The tag is the release line, so update it when
  // a new line branches. A change to the definition reaches this container
  // once it has merged and the image has been published again.
  "image": "ghcr.io/druxt/druxt.js-devcontainer:0.x",
  "containerEnv": {
    // Node is provided by the image - .mise.toml's pin is for host users.
    // Without this, `mise install` tries to build Node from source inside
    // the container.
    "MISE_DISABLE_TOOLS": "node",
    // Pin the example backend's port so the forward below always matches.
    "WEBSERVER_PORT": "8888"
  },
  "forwardPorts": [3000, 8888],
  "portsAttributes": {
    "3000": {
      "label": "Nuxt (examples)",
      "onAutoForward": "silent"
    },
    "8888": {
      "label": "Umami backend (examples/drupal/.devtools)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        // The prose lint that guards every push, as you type. The binary
        // and its styles are installed by post-create.sh, into the place
        // `yarn lint:prose` uses.
        "vale.valeCLI.path": "${workspaceFolder}/.vale/bin/vale",
        "vale.valeCLI.config": "${workspaceFolder}/.vale.ini"
      },
      // Each one serves a tool this repository runs or a file type it
      // holds. .vscode/extensions.json recommends the same list to an
      // editor that is not in a container.
      "extensions": [
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "davidanson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "ChrisChinchilla.vale-vscode",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        // For "Listen for XDebug" in .vscode/launch.json and `make debug` in
        // examples/drupal.
        "xdebug.php-debug",
        // Pinned: the components here are Vue 2.7, and the extension dropped
        // Vue 2 support in 3.1. 3.0.8 is the last release before that.
        "Vue.volar@3.0.8"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
