{
    "name": "druxt/drupal-9-example",
    "description": "Example Drupal 9 backend for use in the Druxt examples.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://druxtjs.org",
    "support": {
        "docs": "https://druxtjs.org",
        "chat": "https://discord.druxtjs.org"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3.0",
        "cweagans/composer-patches": "^1.7.3",
        "drupal-tome/tome_drush": "dev-master",
        "drupal/core-composer-scaffold": "^10",
        "drupal/core-project-message": "^10",
        "drupal/core-recommended": "^10",
        "drupal/decoupled_router": "^2.0.7",
        "drupal/druxt": "^1.2.2",
        "drupal/jsonapi_hypermedia": "^1.10.0",
        "drupal/simple_oauth": "^5.2.5",
        "drupal/tome": "^1.12.0",
        "drush/drush": "^12"
    },
    "require-dev": {
        "drupal/core-dev": "^10"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches": {
            "drupal/decoupled_router": {
                "#3111456 Resolve the language from the requested path, so /es serves Spanish instead of the default language": "patches/decoupled_router-3111456-resolve-language-from-path.patch"
            },
            "drupal/druxt": {
                "#3273228 Add langcode to Views Decoupled Router integration, so the /es front page stays Spanish": "patches/druxt-3273228-views-route-langcode.patch"
            }
        }
    }
}
