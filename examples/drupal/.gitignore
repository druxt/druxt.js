# Ignore directories generated by Composer
/bin/
/recipes/
/drush/Commands/contrib/
/keys/*.key
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings.local.php

# Tome content export mirrors every entity, including OAuth tokens - these
# carry live, valid secret values (see content/oauth2_token.*.json), not
# meaningful demo content. Never commit them.
/content/oauth2_token.*.json

# Ignore the scaffolded docroot except the deliberately tracked settings.
# Content-style excludes (`/web/*`), not directory excludes (`/web/`) —
# git never descends into an excluded directory, so re-inclusion only
# works with this shape.
/web/*
!/web/sites/
/web/sites/*
!/web/sites/default/
/web/sites/default/*
!/web/sites/default/settings.php
!/web/sites/default/files/
/web/sites/default/files/*
!/web/sites/default/files/.gitkeep

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore environment specific files.
/.env
/web/robots.txt
/.editorconfig
/.gitattributes
