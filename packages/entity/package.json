{
  "name": "druxt-entity",
  "version": "0.29.0",
  "description": "Drupal Display Mode powered Entity, Form and Field Druxt components.",
  "keywords": [
    "cms",
    "decoupled",
    "drupal",
    "druxt",
    "druxtjs",
    "entity",
    "entities",
    "field",
    "fields",
    "headless",
    "jsonapi",
    "json:api",
    "nuxt",
    "nuxtjs",
    "module",
    "storybook",
    "vue"
  ],
  "homepage": "https://druxtjs.org",
  "bugs": {
    "url": "https://github.com/druxt/druxt.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druxt/druxt.js",
    "directory": "packages/entity"
  },
  "license": "MIT",
  "author": "Stuart Clark <stuart@druxtjs.org>",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": "./dist/druxt-entity.ssr.js",
      "import": "./dist/druxt-entity.esm.js"
    },
    "./components/*": "./dist/components/*"
  },
  "main": "dist/druxt-entity.ssr.js",
  "module": "dist/druxt-entity.esm.js",
  "files": [
    "dist",
    "templates",
    "icon.svg",
    "banner.svg"
  ],
  "dependencies": {
    "deepmerge": "^4.3.1",
    "drupal-jsonapi-params": "^2.3.2",
    "druxt": "^0.25.0",
    "druxt-router": "^0.32.0",
    "druxt-schema": "^0.12.0"
  },
  "devDependencies": {
    "druxt-test-utils": "^1.0.0",
    "vuex": "^3.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
