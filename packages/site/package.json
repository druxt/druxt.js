{
  "name": "druxt-site",
  "version": "0.15.1",
  "description": "Out of the box Decoupled Drupal sites with Druxt.",
  "keywords": [
    "cms",
    "decoupled",
    "drupal",
    "druxt",
    "druxtjs",
    "headless",
    "jsonapi",
    "json:api",
    "nuxt",
    "nuxtjs",
    "module",
    "storybook",
    "site",
    "vue"
  ],
  "homepage": "https://druxtjs.org",
  "bugs": {
    "url": "https://github.com/druxt/druxt.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druxt/druxt.js",
    "directory": "packages/site"
  },
  "license": "MIT",
  "author": "Stuart Clark <stuart@druxtjs.org>",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": "./dist/druxt-site.ssr.js",
      "import": "./dist/druxt-site.esm.js"
    },
    "./components/*": "./dist/components/*",
    "./layouts/*": "./dist/layouts/*"
  },
  "main": "dist/druxt-site.ssr.js",
  "module": "dist/druxt-site.esm.js",
  "files": [
    "dist",
    "templates",
    "icon.svg",
    "banner.svg"
  ],
  "dependencies": {
    "drupal-jsonapi-params": "^2.3.2",
    "druxt": "^0.25.1",
    "druxt-blocks": "^0.18.1",
    "druxt-breadcrumb": "^0.18.0",
    "druxt-entity": "^0.29.1",
    "druxt-menu": "^0.22.1",
    "druxt-router": "^0.32.1",
    "druxt-schema": "^0.12.1",
    "druxt-views": "^0.23.1"
  },
  "peerDependencies": {
    "vue": "^2.7.14",
    "vuex": "^3.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
