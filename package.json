{
  "name": "druxt.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druxt/druxt.js"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A -t --include '@druxt/*' run build",
    "changeset": "changeset",
    "clean": "rimraf --glob 'packages/*/dist'",
    "lint": "eslint .",
    "lint:audit": "yarn npm audit --all --recursive --environment production --severity high",
    "lint:audit:full": "yarn npm audit --all --recursive",
    "lint:commit": "commitlint",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,mjs,ts,vue,json,md,yml,yaml}\" \"scripts/**/*.sh\"",
    "lint:cspell:worktree": "sh scripts/check-cspell.sh",
    "lint:format": "prettier --check \"**/*.{json,md,yml,yaml}\"",
    "lint:format:fix": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "lint:knip": "knip",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:prose": "yarn lint:prose:install && .vale/bin/vale --config .vale.ini --glob='!{**/node_modules/**,**/dist/**,**/coverage/**,**/CHANGELOG.md,**/CODE_OF_CONDUCT.md,.changeset/README.md,**/.github/**,**/.yarn/**,**/.nuxt/**,**/.output/**,**/.nuxt-storybook/**,examples/drupal/web/**,examples/drupal/vendor/**,examples/drupal/keys/**}' packages *.md examples .changeset .agents",
    "lint:prose:install": "bash scripts/install-vale.sh .vale/bin .vale/styles",
    "lint:renovate": "renovate-config-validator",
    "lint:skills": "npx --yes agnix@0.56.1 --strict . && node scripts/skills/check-descriptions.mjs",
    "release:check": "node scripts/release/check.mjs",
    "release:check:test": "node --test scripts/release/test/*.test.mjs",
    "skills:eval": "cd .agents/evals && npm install --no-audit --no-fund && npx promptfoo eval -c promptfooconfig.yaml",
    "postinstall": "husky install",
    "version": "changeset version && node scripts/changelog-dates.mjs && yarn install --mode=update-lockfile",
    "test": "vitest run --passWithNoTests"
  },
  "resolutions": {
    "human-id": "4.1.3",
    "brace-expansion@npm:^2.0.1": "^2.1.6",
    "brace-expansion@npm:^2.0.2": "^2.1.6",
    "brace-expansion@npm:^5.0.8": "^5.0.11",
    "undici@npm:^8.4.1": "^8.10.2",
    "@nuxt/devtools@npm:^3.4.1": "^3.4.3",
    "source-map-js@npm:^1.2.1": "^1.2.2"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "16.0",
    "@commitlint/config-conventional": "16.0",
    "@commitlint/is-ignored": "^16.2.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "^24.19.1",
    "@vue/test-utils": "^2.4.6",
    "consola": "^3.4.2",
    "cspell": "^7.3.9",
    "drupal-jsonapi-params": "^2.3.2",
    "eslint": "^10.12.0",
    "happy-dom": "^20.0.11",
    "husky": "8.0.3",
    "knip": "^6.39.0",
    "lint-staged": "^14.0.1",
    "markdownlint-cli2": "^0.13.0",
    "prettier": "^3.9.9",
    "renovate": "32.0.2",
    "rimraf": "5.0.10",
    "semver": "^7.8.5",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "^24.11.0",
    "yarn": "4.18.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix",
      "cspell lint --no-progress --no-must-find-files"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write",
      "cspell lint --no-progress --no-must-find-files"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint-cli2",
      "cspell lint --no-progress --no-must-find-files"
    ],
    "{AGENTS.md,.agnix.toml,.agents/skills/**/SKILL.md}": [
      "npx --yes agnix@0.56.1 --strict",
      "node scripts/skills/check-descriptions.mjs"
    ]
  }
}
