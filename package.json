{
  "name": "druxt.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druxt/druxt.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn clean && siroc build",
    "build:docs": "./packages/docgen/bin/druxt-docgen.js",
    "bundlewatch": "bundlewatch --config bundlewatch.config.js",
    "changeset": "changeset",
    "clean": "yarn clean:dist && yarn clean:docs && yarn clean:pack",
    "clean:docs": "rimraf docs/nuxt/content/api",
    "clean:dist": "rimraf --glob 'packages/*/dist' 'packages/*/nuxt'",
    "clean:pack": "rimraf --glob 'packages/*/package.tgz'",
    "dev": "siroc dev",
    "docs:dev": "cd docs/nuxt && yarn && yarn dev",
    "docs:test": "start-server-and-test docs:dev http://localhost:3000 'npx cypress run --project docs/nuxt/test'",
    "docs:test:open": "start-server-and-test docs:dev http://localhost:3000 'npx cypress open --project docs/nuxt/test'",
    "example:druxt-site": "cd examples/druxt-site && yarn && yarn dev",
    "example:druxt-site:storybook": "cd examples/druxt-site && yarn && yarn storybook",
    "example:druxt-site:storybook:test": "start-server-and-test 'yarn example:druxt-site:storybook --port 3000' http://localhost:3000 'npx cypress run --project examples/druxt-site/test --spec \"examples/druxt-site/test/cypress/e2e/storybook/*.cy.js\"'",
    "example:druxt-site:storybook:test:open": "start-server-and-test 'yarn example:druxt-site:storybook --port 3000' http://localhost:3000 'npx cypress open --project examples/druxt-site/test'",
    "example:druxt-site:test": "start-server-and-test 'yarn example:druxt-site' http://localhost:3000 'npx cypress run --project examples/druxt-site/test --spec \"examples/druxt-site/test/cypress/e2e/nuxt/*.cy.js\"'",
    "example:druxt-site:test:open": "start-server-and-test 'yarn example:druxt-site' http://localhost:3000 'npx cypress open --project examples/druxt-site/test'",
    "lint": "eslint --ext .js,.vue packages/*/src",
    "lint:audit": "yarn npm audit --recursive --environment production --severity high",
    "lint:audit:full": "yarn npm audit --recursive",
    "lint:commit": "commitlint",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,vue,json,md,yml,yaml}\"",
    "lint:format": "prettier --check \"**/*.{js,vue,json,md,yml,yaml}\"",
    "lint:format:fix": "prettier --write \"**/*.{js,vue,json,md,yml,yaml}\"",
    "lint:knip": "knip --include dependencies,unlisted --no-config-hints",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:renovate": "renovate-config-validator",
    "package": "siroc run yarn pack --workspaces",
    "postinstall": "husky install",
    "test": "yarn test:unit && yarn test:e2e",
    "test:e2e": "yarn example:druxt-site:test && yarn example:druxt-site:storybook:test",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=warn jest",
    "version": "changeset version && node scripts/changelog-dates.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "16.0",
    "@commitlint/config-conventional": "16.0",
    "@vue/test-utils": "1.3.6",
    "babel-core": "7.0.0-bridge.0",
    "bundlewatch": "0.4.2",
    "cspell": "^7.3.8",
    "cypress": "^13.14.1",
    "esbuild": "0.23.1",
    "esbuild-jest": "0.5.0",
    "eslint": "7.32.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-junit": "1.0.1",
    "eslint-plugin-jsdoc": "^39.9.1",
    "eslint-plugin-nuxt": "2.0.0",
    "eslint-plugin-vue": "7.20.0",
    "eslint-plugin-yml": "^1.14.0",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "16.0.0",
    "jest-mock-axios": "4.7.3",
    "knip": "2.43.0",
    "lint-staged": "^14.0.0",
    "markdownlint-cli2": "^0.13.0",
    "node-gyp": "^9.4.1",
    "prettier": "^3.3.3",
    "regenerator-runtime": "0.14.1",
    "renovate": "32.0.2",
    "rimraf": "5.0.10",
    "siroc": "0.16.0",
    "start-server-and-test": "^2.0.5",
    "vue": "2.7.16",
    "vue-jest": "3.0.7",
    "vue-template-compiler": "2.7.16"
  },
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": "16.20.1",
    "yarn": "3.6.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --fix-type problem,layout,suggestion",
      "cspell lint --no-progress --no-must-find-files"
    ],
    "*.vue": [
      "eslint --fix --fix-type problem,layout,suggestion",
      "cspell lint --no-progress --no-must-find-files"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write",
      "cspell lint --no-progress --no-must-find-files"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint-cli2",
      "cspell lint --no-progress --no-must-find-files"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  }
}
