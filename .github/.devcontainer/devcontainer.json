{
  // The definition of the prebuilt dev container image, which
  // .github/workflows/devcontainer.yml builds and publishes to
  // ghcr.io/druxt/druxt.js-devcontainer. It holds everything that is the
  // same for every checkout: the tools, PHP and its extensions, and the
  // locales. What depends on the checkout, such as `yarn install`, stays in
  // .devcontainer/post-create.sh.
  //
  // It lives here, not under .devcontainer/, so an editor that opens the
  // repository finds one dev container, not a choice of two.
  "name": "Druxt dev container image",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "16.20.1"
    },
    // Installed through gh-release rather than the mise feature: that
    // feature asks for the "latest" jdx/mise release and does not expose
    // a tag filter, and mise now publishes vfox-* releases from the same
    // repository. The regex keeps us on mise's own v-tags while still
    // tracking the newest one.
    "ghcr.io/devcontainers-extra/features/gh-release:1": {
      "repo": "jdx/mise",
      "binaryNames": "mise",
      // mise ships the same build as .tar.gz, .tar.xz, .tar.zst and an
      // extensionless binary; without this the resolver finds four
      // matches and refuses to choose.
      "assetRegex": ".tar.gz$",
      "releaseTagRegex": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // PHP for examples/drupal, provisioned without Docker by its .devtools.
    // 8.3 is the backend's composer platform pin and what both CI systems
    // run. The feature builds PHP against trixie's libsqlite3, which meets
    // Drupal 11's 3.45 minimum.
    "ghcr.io/devcontainers/features/php:1": {
      "version": "8.3",
      "installComposer": true
    },
    // node-gyp toolchain for the monorepo's native addons (deasync, re2):
    // the base image ships none of it and `yarn install` fails without
    // it. sqlite3 is the CLI drush reaches for; the image libraries are
    // gd's. locales is for the ones the local feature generates.
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "python3,python3-setuptools,build-essential,sqlite3,libjpeg-dev,libpng-dev,libwebp-dev,libfreetype-dev,zlib1g-dev,locales"
    },
    // The parts no published feature covers: PHP's gd extension, the PHP
    // settings the example backend needs, and the locales.
    "./features/druxt": {}
  },
  "remoteUser": "vscode"
}
